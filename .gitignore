# OS & Editor files
.DS_Store
Thumbs.db
*.swp
*.tmp
.vscode/
.idea/

# Node modules / build output (if framework added later)
node_modules/
dist/
build/
.cache/

# Servidor local: configuración con IDs reales y datos de visitantes
server/ads-config.json
server/data/*
!server/data/.gitignore
server/meta-config.json
server/meta-config.old.json
server/cf-config.json
# (la config del CRM va en server/data/crm-config.json, cubierta por server/data/*)

# Haztek: almacén de datos propio del proyecto cliente (separable de OPIA)
haztek/data/*

# Datos personales de origen (Ley 1581): se importan, nunca se commitean
DatosInicialesCRM/

# Bytecode de Python
__pycache__/
*.pyc

# Privado: datos de conexión al servidor y estado del despliegue
AGENTS.local.md
.deployed-commit
